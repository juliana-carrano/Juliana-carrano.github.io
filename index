async function searchAndCenterMap(){
  const q = document.getElementById('map-search').value.trim();
  if(!q || !leafletMap) return;
  try{
    const data = await fetchJsonRobust('https://geocoding-api.open-meteo.com/v1/search?count=1&language=pt&format=json&name='+encodeURIComponent(q));
    if(data && data.results && data.results[0]){
      const r = data.results[0];
      leafletMap.setView([r.latitude,r.longitude], 14);
      L.marker([r.latitude,r.longitude]).addTo(leafletMap).bindPopup(escapeHtml([r.name,r.admin1,r.country].filter(Boolean).join(', '))).openPopup();
      return;
    }
  }catch(e){ /* tenta o próximo provedor */ }
  try{
    const data = await fetchJsonRobust('https://photon.komoot.io/api/?limit=1&lang=pt&q='+encodeURIComponent(q));
    const f = data && data.features && data.features[0];
    if(f && f.geometry && f.geometry.coordinates){
      const [lng,lat] = f.geometry.coordinates;
      leafletMap.setView([lat,lng], 14);
      const p = f.properties||{};
      L.marker([lat,lng]).addTo(leafletMap).bindPopup(escapeHtml([p.name,p.city,p.country].filter(Boolean).join(', '))).openPopup();
      return;
    }
  }catch(e){ /* segue para o alerta abaixo */ }
  showToast('Local não encontrado em nenhum serviço agora. Tente um termo mais simples/um endereço completo, ou clique diretamente no mapa.', true);
}
function plotDestinationHubs(bounds){
  currentTrip.destinations.forEach(d=>{
    if(d.lat!=null && d.lng!=null){
      const m = L.circleMarker([d.lat,d.lng], {radius:13, color:'#1F2E45', weight:2, fillColor:d.color, fillOpacity:0.9})
        .addTo(leafletMap).bindPopup(`<b>${escapeHtml(d.name)}</b><br>${d.currency} · ${(TIMEZONES.find(z=>z[0]===d.timezone)||[,d.timezone])[1]}`);
      mapMarkers.push(m);
      if(bounds) bounds.push([d.lat,d.lng]);
    }
  });
