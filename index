    `https://latest.currency-api.pages.dev/v1/currencies/${from}.json`
  ];
  for(const url of urls){
    try{
      const res = await fetch(url);
      if(!res.ok) continue;
      const data = await res.json();
      const rates = data[from];
      if(rates && rates[to]!=null){
        const rate = rates[to];
