/* Migrates older single-destination trips into the new destinations[] model,
   and keeps the packing/weather shape consistent. Safe to call every load. */
function ensureTripShape(data, meta){
  if(!data.destinations || !data.destinations.length){
    data.destinations = [{
      id: uid(),
      name: meta.destination || meta.name || 'Destino 1',
      lat: meta.lat ?? null,
      lng: meta.lng ?? null,
      timezone: meta.timezone || 'America/Sao_Paulo',
      currency: meta.currency || 'BRL',
      startDate: meta.startDate,
      endDate: meta.endDate,
      color: TRIP_COLORS[0]
    }];
  }
  if(!data.packing) data.packing = { items: [], weatherByDest: {}, outfitsByDate: {} };
  if(!data.packing.weatherByDest){
    data.packing.weatherByDest = {};
    if(data.packing.weather){
      data.packing.weatherByDest[data.destinations[0].id] = data.packing.weather;
      delete data.packing.weather;
    }
  }
  if(!data.packing.outfitsByDate) data.packing.outfitsByDate = {};
  if(!data.itinerary) data.itinerary = { days: [] };
  if(!data.people) data.people = [];
  if(!data.expenses) data.expenses = [];
  if(!data.settlements) data.settlements = [];
  if(!data.bookings) data.bookings = [];
  data.bookings.forEach(b=>{
    if(!b.attachments){
      b.attachments = b.hasFile ? [{id:b.id, name:b.fileName||'arquivo.pdf', type:b.fileType||'application/pdf'}] : [];
      delete b.hasFile; delete b.fileName; delete b.fileType;
    }
  });
  if(!data.documents) data.documents = [];
  data.documents.forEach(d=>{
    if(d.dueDate===undefined) d.dueDate = null;
    if(d.priority===undefined) d.priority = null;
    if(d.notes===undefined) d.notes = '';
  });
  assignDayDestinationsFor(data);
  return data;
}

function buildDays(startDate, endDate, existingDays){
  const days = [];
  if(!startDate || !endDate) return days;
  let d = new Date(startDate+'T00:00:00');
  const end = new Date(endDate+'T00:00:00');
  if(isNaN(d)||isNaN(end)||d>end) return existingDays||[];
  const oldByDate = {};
  (existingDays||[]).forEach(day=>{ oldByDate[day.date]=day; });
  while(d<=end){
    const iso = d.toISOString().slice(0,10);
    days.push(oldByDate[iso] || {date:iso, items:[], destinationId:null});
    d.setDate(d.getDate()+1);
  }
  return days;
}

function assignDayDestinationsFor(data){
  const ds = data.destinations;
  (data.itinerary.days||[]).forEach(day=>{
    const stillValid = day.destinationId && ds.find(d=>d.id===day.destinationId);
    if(stillValid) return;
    const match = ds.find(d=> d.startDate && d.endDate && d.startDate<=day.date && day.date<=d.endDate);
    day.destinationId = match ? match.id : (ds[0] ? ds[0].id : null);
  });
}
function assignDayDestinations(){ assignDayDestinationsFor(currentTrip); }

function recomputeTripRange(){
  const meta = tripsIndex.find(x=>x.id===currentTripId);
  const ds = currentTrip.destinations;
  if(!meta || !ds.length) return;
  const starts = ds.map(d=>d.startDate).filter(Boolean).sort();
  const ends = ds.map(d=>d.endDate).filter(Boolean).sort();
  if(starts.length) meta.startDate = starts[0];
  if(ends.length) meta.endDate = ends[ends.length-1];
  currentTrip.itinerary.days = buildDays(meta.startDate, meta.endDate, currentTrip.itinerary.days);
  assignDayDestinations();
}

function fmtDateHuman(iso){
  if(!iso) return '';
  const d = new Date(iso+'T00:00:00');
  return d.toLocaleDateString('pt-BR', {weekday:'short', day:'2-digit', month:'short'});
}
function fmtDateShort(iso){
  if(!iso) return '';
  const d = new Date(iso+'T00:00:00');
  return d.toLocaleDateString('pt-BR', {day:'2-digit', month:'2-digit', year:'numeric'});
}
function escapeHtml(s){
  return (s||'').toString().replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
function haversine(lat1,lon1,lat2,lon2){
  const R=6371;
  const dLat=(lat2-lat1)*Math.PI/180, dLon=(lon2-lon1)*Math.PI/180;
  const a=Math.sin(dLat/2)**2+Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*Math.sin(dLon/2)**2;
  return R*2*Math.atan2(Math.sqrt(a),Math.sqrt(1-a));
}
