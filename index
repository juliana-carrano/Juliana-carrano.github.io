/* Tries a direct fetch first; if that fails outright (e.g. a specific domain is blocked on this
   network while others work fine — as confirmed happens with open-meteo.com for some users),
   retries the same request through a public CORS proxy on a completely different domain. */
async function fetchJsonRobust(url){
  try{
    const res = await fetch(url);
    if(res.ok) return await res.json();
  }catch(e){ console.error('fetch direto falhou', url, e); }
  const proxies = [
    'https://api.allorigins.win/raw?url=' + encodeURIComponent(url),
    'https://corsproxy.io/?url=' + encodeURIComponent(url),
    'https://thingproxy.freeboard.io/fetch/' + url,
  ];
  for(const proxied of proxies){
    try{
      const res = await fetch(proxied);
      if(res.ok) return await res.json();
    }catch(e){ console.error('fetch via proxy também falhou', proxied, e); }
  }
  return null;
}
const CLIMATE_HISTORY_YEARS = 5; // quantos anos anteriores usar para calcular a média histórica

async function fetchWeather(destId){
  const d = currentTrip.destinations.find(x=>x.id===destId);
  const box = document.getElementById('weather-box-'+destId);
  box.innerHTML = 'Buscando previsão...';
  const today = new Date(); today.setHours(0,0,0,0);
  const start = new Date(d.startDate+'T00:00:00');
  const daysAhead = Math.round((start-today)/86400000);
  try{
    if(daysAhead>=0 && daysAhead<=15){
      // Dentro do alcance de uma previsão real
      const url = `https://api.open-meteo.com/v1/forecast?latitude=${d.lat}&longitude=${d.lng}&daily=temperature_2m_max,temperature_2m_min,precipitation_probability_max&timezone=auto&start_date=${d.startDate}&end_date=${d.endDate}`;
      const data = await fetchJsonRobust(url);
      if(data && data.daily && data.daily.time && data.daily.time.length){
        const weather = {days:data.daily.time.map((dt,i)=>({
          date:dt,
          tmax:data.daily.temperature_2m_max[i],
          tmin:data.daily.temperature_2m_min[i],
          rain:data.daily.precipitation_probability_max ? data.daily.precipitation_probability_max[i] : null
        })), isForecast:true, fetchedAt:new Date().toISOString()};
        if(!currentTrip.packing.weatherByDest) currentTrip.packing.weatherByDest = {};
        currentTrip.packing.weatherByDest[destId] = weather;
        await saveCurrentTrip();
        renderWeatherBox(destId, weather);
        return;
      }
      throw new Error('Resposta sem dados diários');
    } else {
      // Viagem distante demais para uma previsão real: em vez de usar só o ano passado (que pode
      // ter sido um ano atípico), busca vários anos anteriores e mostra a média histórica —
      // mais representativa do "clima normal" dessa época do ano nessas coordenadas.
      const weather = await fetchHistoricalAverage(d);
      if(weather){
        if(!currentTrip.packing.weatherByDest) currentTrip.packing.weatherByDest = {};
        currentTrip.packing.weatherByDest[destId] = weather;
        await saveCurrentTrip();
        renderWeatherBox(destId, weather);
        return;
      }
      throw new Error('Sem dados históricos suficientes');
    }
  }catch(e){
    console.error('fetchWeather falhou', e);
    renderWeatherManualForm(destId);
  }
}
/* Fetches up to CLIMATE_HISTORY_YEARS previous years covering the same date range (month/day)
   and averages them day-by-day, instead of relying on a single past year that could have been
   unusually hot, cold, or rainy. Also turns rain into "% of those years it rained" rather than
   a forecast probability, since historical archive data has no such probability field. */
async function fetchHistoricalAverage(d){
  const startBase = new Date(d.startDate+'T00:00:00');
  const endBase = new Date(d.endDate+'T00:00:00');
  const numDays = Math.round((endBase-startBase)/86400000) + 1;
  const yearsData = [];
  for(let y=1; y<=CLIMATE_HISTORY_YEARS; y++){
    const ys = shiftYear(d.startDate,-y), ye = shiftYear(d.endDate,-y);
    const url = `https://archive-api.open-meteo.com/v1/archive?latitude=${d.lat}&longitude=${d.lng}&daily=temperature_2m_max,temperature_2m_min,precipitation_sum&timezone=auto&start_date=${ys}&end_date=${ye}`;
    try{
      const data = await fetchJsonRobust(url);
      if(data && data.daily && data.daily.time && data.daily.time.length) yearsData.push(data.daily);
    }catch(e){ /* esse ano falhou, tenta os outros */ }
  }
  if(yearsData.length===0) return null;
  const days = [];
  for(let i=0;i<numDays;i++){
    const tmaxVals=[], tminVals=[], precipVals=[];
    yearsData.forEach(yd=>{
      if(yd.temperature_2m_max && yd.temperature_2m_max[i]!=null) tmaxVals.push(yd.temperature_2m_max[i]);
      if(yd.temperature_2m_min && yd.temperature_2m_min[i]!=null) tminVals.push(yd.temperature_2m_min[i]);
      if(yd.precipitation_sum && yd.precipitation_sum[i]!=null) precipVals.push(yd.precipitation_sum[i]);
    });
    if(tmaxVals.length===0) continue;
    const avg = arr=>arr.reduce((s,v)=>s+v,0)/arr.length;
    const rainyCount = precipVals.filter(p=>p>=1).length;
    const rainPct = precipVals.length ? Math.round(rainyCount/precipVals.length*100) : null;
    const dateForDay = new Date(startBase.getTime() + i*86400000).toISOString().slice(0,10);
    days.push({date:dateForDay, tmax:avg(tmaxVals), tmin:avg(tminVals), rain:rainPct});
  }
  if(days.length===0) return null;
  return {days, isForecast:false, isHistoricalAverage:true, yearsUsed:yearsData.length, fetchedAt:new Date().toISOString()};
}
function shiftYear(iso,delta){
  const d = new Date(iso+'T00:00:00');
  d.setFullYear(d.getFullYear()+delta);
  return d.toISOString().slice(0,10);
}
/* Shown whenever the automatic forecast fails for any reason (network, CORS, no data for the
