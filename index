  const stops = cats.filter(c=>(+c.actual||0)>0).map((c,i)=>{
    const pct = (+c.actual||0)/total*100;
    const start = acc; acc += pct;
    return `${BUDGET_CHART_COLORS[i%BUDGET_CHART_COLORS.length]} ${start}% ${acc}%`;
  });
  const legend = cats.filter(c=>(+c.actual||0)>0).map((c,i)=>`
