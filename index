function buildDayPlainText(dayIndex){
  const t = tripsIndex.find(x=>x.id===currentTripId);
  const day = currentTrip.itinerary.days[dayIndex];
  const dateObj = new Date(day.date+'T00:00:00');
  const dest = currentTrip.destinations.find(d=>d.id===day.destinationId);
  const items = [...day.items].sort((a,b)=>(a.timeStart||a.time||'99:99').localeCompare(b.timeStart||b.time||'99:99'));
  const lines = [];
  lines.push(`📅 ${escapeAmp(t.name)} — Dia ${dayIndex+1}, ${dateObj.toLocaleDateString('pt-BR',{weekday:'long',day:'2-digit',month:'long'})}`);
  if(dest) lines.push(`📍 ${dest.name}`);
  lines.push('');
  if(items.length===0){
    lines.push('Nenhuma atividade planejada ainda.');
  } else {
    items.forEach(it=>{
      const time = (it.timeStart||it.time) ? (it.timeStart||it.time)+(it.timeEnd?' – '+it.timeEnd:'') : 'Sem horário definido';
      lines.push(`${time}  ${CATEGORY_ICONS[it.category]||'📌'} ${it.title}`);
      if(it.place) lines.push(`   📍 ${it.place}`);
      if(it.needsReservation) lines.push(`   ${it.reservationConfirmed?'✅ reserva confirmada':'🎫 precisa reservar'}`);
      if(it.link) lines.push(`   🔗 ${it.link}`);
      if(it.notes) lines.push(`   Obs: ${it.notes}`);
      lines.push('');
    });
  }
  lines.push('— Gerado pelo Diário de Bordo');
  return lines.join('\n');
}
