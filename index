}
function computeTripStats(){
  let totalKm = 0;
  currentTrip.itinerary.days.forEach(day=>{
    const pts = day.items.filter(it=>it.lat!=null&&it.lng!=null).sort((a,b)=>(a.timeStart||a.time||'99:99').localeCompare(b.timeStart||b.time||'99:99'));
    for(let i=0;i<pts.length-1;i++) totalKm += haversine(pts[i].lat,pts[i].lng,pts[i+1].lat,pts[i+1].lng);
  });
  const hubs = currentTrip.destinations.filter(d=>d.lat!=null&&d.lng!=null).slice().sort((a,b)=>(a.startDate||'').localeCompare(b.startDate||''));
  for(let i=0;i<hubs.length-1;i++) totalKm += haversine(hubs[i].lat,hubs[i].lng,hubs[i+1].lat,hubs[i+1].lng);
  return {totalKm};
}
