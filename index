function initItemMiniMap(di, editing){
  const el = document.getElementById('item-map-mini');
  if(!el || !window.L) return;
  el.style.height='220px'; el.style.borderRadius='10px'; el.style.border='1px solid var(--line)';
  if(itemMiniMap){ itemMiniMap.remove(); itemMiniMap=null; itemMiniMarker=null; }
  const day = currentTrip.itinerary.days[di];
  const dest = currentTrip.destinations.find(d=>d.id===day.destinationId) || currentTrip.destinations[0];
  const hasPoint = editing && editing.lat!=null && editing.lng!=null;
  const startLat = hasPoint ? editing.lat : (dest&&dest.lat!=null?dest.lat:20);
  const startLng = hasPoint ? editing.lng : (dest&&dest.lng!=null?dest.lng:0);
  const zoom = hasPoint ? 14 : (dest&&dest.lat!=null?11:2);
  itemMiniMap = L.map('item-map-mini',{zoomControl:true}).setView([startLat,startLng], zoom);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {attribution:'&copy; OpenStreetMap contributors', maxZoom:19}).addTo(itemMiniMap);
  if(hasPoint) placeItemMiniMarker(editing.lat, editing.lng);
  updateItemMapCoordsLabel(hasPoint?editing.lat:null, hasPoint?editing.lng:null);
  itemMiniMap.on('click', e=>{ placeItemMiniMarker(e.latlng.lat, e.latlng.lng); });
}
function placeItemMiniMarker(lat,lng){
  if(itemMiniMarker){ itemMiniMap.removeLayer(itemMiniMarker); itemMiniMarker=null; }
  itemMiniMarker = L.marker([lat,lng], {draggable:true}).addTo(itemMiniMap);
  itemMiniMarker.on('dragend', ()=>{ const ll=itemMiniMarker.getLatLng(); updateItemMapCoordsLabel(ll.lat,ll.lng); });
  updateItemMapCoordsLabel(lat,lng);
}
function clearItemMiniMarker(){
  if(itemMiniMarker){ itemMiniMap.removeLayer(itemMiniMarker); itemMiniMarker=null; }
  updateItemMapCoordsLabel(null,null);
}
function updateItemMapCoordsLabel(lat,lng){
  const el = document.getElementById('item-map-coords');
  if(!el) return;
  el.textContent = (lat!=null && lng!=null) ? `📍 ${lat.toFixed(5)}, ${lng.toFixed(5)}` : 'Nenhum local marcado ainda — clique no mapa acima.';
  el.dataset.lat = (lat!=null)?lat:'';
  el.dataset.lng = (lng!=null)?lng:'';
}
async function saveItem(di, itemId){
  const day = currentTrip.itinerary.days[di];
  const timeStart = document.getElementById('it-time-start').value;
  const timeEnd = document.getElementById('it-time-end').value;
  const category = document.getElementById('it-cat').value;
  const title = document.getElementById('it-title').value.trim();
  const place = document.getElementById('it-place').value.trim();
  const link = document.getElementById('it-link').value.trim();
  const needsReservation = document.getElementById('it-needs-res').checked;
  const reservationConfirmed = document.getElementById('it-res-confirmed').checked;
  const notes = document.getElementById('it-notes').value.trim();
  const coordsEl = document.getElementById('item-map-coords');
  const lat = coordsEl && coordsEl.dataset.lat ? parseFloat(coordsEl.dataset.lat) : null;
  const lng = coordsEl && coordsEl.dataset.lng ? parseFloat(coordsEl.dataset.lng) : null;
  if(!title){ showToast('Dê um título para a atividade.', true); return; }
  const fields = {timeStart, timeEnd, category, title, place, link, needsReservation, reservationConfirmed, notes, lat, lng};
  if(itemId){
    const it = day.items.find(i=>i.id===itemId);
    delete it.time; // migra de vez o campo antigo
    Object.assign(it, fields);
  } else {
    day.items.push({id:uid(), ...fields});
  }
  await saveCurrentTrip();
  closeModal();
  renderSection();
}
async function removeItem(di,itemId){
