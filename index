function plotMapMarkers(){
  mapMarkers.forEach(m=>leafletMap.removeLayer(m));
  mapMarkers = [];
  const days = currentTrip.itinerary.days;
  const distDiv = document.getElementById('map-distances');
  const bounds = [];

  if(mapSelectedDay===-1){
    plotDestinationHubs(bounds);
    days.forEach((day,di)=>{
      const color = day.destinationId ? destColor(day.destinationId) : DAY_COLORS[di%DAY_COLORS.length];
      day.items.filter(it=>it.lat&&it.lng).forEach(it=>{
        const m = L.circleMarker([it.lat,it.lng], {radius:7,color, fillColor:color, fillOpacity:.85})
          .addTo(leafletMap).bindPopup(`<b>Dia ${di+1}</b> · ${escapeHtml(it.title)}`);
        mapMarkers.push(m);
        bounds.push([it.lat,it.lng]);
      });
    });
    let html = '<div class="note">Selecione um dia específico para ver a distância calculada entre os pontos daquele dia.</div>';
    const orderedHubs = currentTrip.destinations.filter(d=>d.lat!=null&&d.lng!=null).slice().sort((a,b)=>(a.startDate||'').localeCompare(b.startDate||''));
    if(orderedHubs.length>1){
      let total=0, rows=[];
      for(let i=0;i<orderedHubs.length-1;i++){
        const dd = haversine(orderedHubs[i].lat,orderedHubs[i].lng,orderedHubs[i+1].lat,orderedHubs[i+1].lng);
        total+=dd;
        rows.push(`${escapeHtml(orderedHubs[i].name)} → ${escapeHtml(orderedHubs[i+1].name)}: <b>${dd.toFixed(0)} km</b>`);
      }
      html = `<h3>📏 Distâncias entre destinos</h3><div class="distlist">${rows.join('<br>')}<br><br>Total entre destinos: <b>${total.toFixed(0)} km</b></div>` + html;
    }
    distDiv.innerHTML = html;
  } else {
    plotDestinationHubs(null);
    const day = days[mapSelectedDay];
    const color = day.destinationId ? destColor(day.destinationId) : DAY_COLORS[mapSelectedDay%DAY_COLORS.length];
    const pts = day.items.filter(it=>it.lat&&it.lng).sort((a,b)=>(a.time||'99:99').localeCompare(b.time||'99:99'));
    pts.forEach((it,i)=>{
      const m = L.marker([it.lat,it.lng]).addTo(leafletMap)
        .bindPopup(`<b>${i+1}. ${escapeHtml(it.title)}</b><br>${it.time||''}`);
      mapMarkers.push(m);
      bounds.push([it.lat,it.lng]);
    });
    if(pts.length>1){
      const line = L.polyline(pts.map(p=>[p.lat,p.lng]), {color, weight:3, dashArray:'6 6'}).addTo(leafletMap);
      mapMarkers.push(line);
      let total=0, rows=[];
      for(let i=0;i<pts.length-1;i++){
        const d = haversine(pts[i].lat,pts[i].lng,pts[i+1].lat,pts[i+1].lng);
        total+=d;
        rows.push(`${i+1}. ${escapeHtml(pts[i].title)} → ${escapeHtml(pts[i+1].title)}: <b>${d.toFixed(1)} km</b>`);
      }
      distDiv.innerHTML = `<h3>📏 Distâncias — Dia ${mapSelectedDay+1}</h3><div class="distlist">${rows.join('<br>')}<br><br>Total do dia: <b>${total.toFixed(1)} km</b></div>`;
    } else if(pts.length===1){
      distDiv.innerHTML = '<div class="note">Apenas um ponto marcado neste dia — adicione mais para calcular distâncias.</div>';
    } else {
      distDiv.innerHTML = '<div class="note">Nenhum ponto marcado neste dia ainda. Vá ao Roteiro e clique em 📍 numa atividade.</div>';
    }
  }
  if(bounds.length) leafletMap.fitBounds(bounds, {padding:[40,40]});
}

