      </div>
      <div class="row">
        <div class="field"><label>Moeda</label>${currencyInputHtml('exp-curr', defCurrency)}</div>
        <div class="field"><label>Valor total</label><input id="exp-amount" type="number" step="0.01" value="${editing?editing.amount:''}"></div>
      </div>
      <div class="field">
        <label>Equivalente em ${refCurrency()} (usado para calcular os saldos)</label>
        <div style="display:flex;gap:6px;">
          <input id="exp-amountref" type="number" step="0.01" value="${editing?editing.amountRef:''}">
          <button type="button" class="btn ghost sm" onclick="convertExpenseAmount()">🔄 Converter</button>
        </div>
      </div>
      <h3 style="margin-top:14px;">💰 Quem pagou?</h3>
      <div class="note" style="margin-bottom:4px;">Marque quem pagou e quanto (na moeda escolhida acima), ou clique "tudo" se foi só uma pessoa.</div>
      <div id="exp-payers">${people.map(payerRow).join('')}</div>
      <h3 style="margin-top:14px;">⚖️ Dividir entre</h3>
      <div class="note" style="margin-bottom:4px;">Marque quem participa desta despesa. <button type="button" class="iconbtn" style="text-decoration:underline;font-size:12px;padding:0;" onclick="splitEqually()">dividir igualmente entre os marcados</button></div>
      <div id="exp-split">${people.map(splitRow).join('')}</div>
      <div class="field" style="margin-top:10px;"><label>Notas</label><textarea id="exp-notes">${editing?escapeHtml(editing.notes||''):''}</textarea></div>
      <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:16px;">
        <button class="btn ghost" onclick="closeModal()">Cancelar</button>
        <button class="btn brass" onclick="saveExpense('${newId}')">Salvar</button>
      </div>
    </div>
  </div>`;
}
function setSolePayer(personId){
  const total = parseFloat(document.getElementById('exp-amount').value)||0;
  currentTrip.people.forEach(p=>{
    const chk = document.getElementById('pay-chk-'+p.id);
    const amt = document.getElementById('pay-amt-'+p.id);
    if(p.id===personId){ chk.checked=true; amt.value=total.toFixed(2); }
    else { chk.checked=false; amt.value=''; }
  });
}
function splitEqually(){
  const total = parseFloat(document.getElementById('exp-amount').value)||0;
  const checked = currentTrip.people.filter(p=>document.getElementById('split-chk-'+p.id).checked);
  if(checked.length===0){ showToast('Marque ao menos uma pessoa para dividir.', true); return; }
  const share = Math.floor((total/checked.length)*100)/100;
  const remainder = Math.round((total - share*checked.length)*100)/100;
  checked.forEach((p,i)=>{
    const amt = (i===0) ? Math.round((share+remainder)*100)/100 : share;
    document.getElementById('split-amt-'+p.id).value = amt.toFixed(2);
  });
  currentTrip.people.filter(p=>!checked.includes(p)).forEach(p=>{
    document.getElementById('split-amt-'+p.id).value = '';
  });
}
async function convertExpenseAmount(){
  const from = document.getElementById('exp-curr').value.trim().toUpperCase();
  const to = refCurrency();
  const amount = parseFloat(document.getElementById('exp-amount').value)||0;
  const result = await convertViaApi(from,to,amount);
  if(result!=null) document.getElementById('exp-amountref').value = result.toFixed(2);
  else showToast('Conversão indisponível agora — preencha o valor equivalente manualmente.', true);
}
async function saveExpense(id){
  const description = document.getElementById('exp-desc').value.trim();
  const category = document.getElementById('exp-cat').value;
  const date = document.getElementById('exp-date').value;
  const currency = document.getElementById('exp-curr').value.trim().toUpperCase();
  const amount = parseFloat(document.getElementById('exp-amount').value)||0;
  let amountRef = parseFloat(document.getElementById('exp-amountref').value);
  const notes = document.getElementById('exp-notes').value.trim();
  if(!description || amount<=0){ showToast('Preencha a descrição e um valor total maior que zero.', true); return; }

  if(currency===refCurrency()){
    if(isNaN(amountRef) || amountRef<=0) amountRef = amount;
  } else if(isNaN(amountRef) || amountRef<=0){
    // Última tentativa: buscar a conversão automaticamente antes de bloquear o salvamento
    const auto = await convertViaApi(currency, refCurrency(), amount);
    if(auto!=null){
      amountRef = auto;
    } else {
      showToast(`Informe o valor equivalente em ${refCurrency()} (clique em "🔄 Converter" ou digite manualmente) antes de salvar — isso é essencial para o cálculo dos saldos ficar correto.`, true);
      return;
    }
  }

  const paidBy = currentTrip.people.filter(p=>document.getElementById('pay-chk-'+p.id).checked)
    .map(p=>({personId:p.id, amount:parseFloat(document.getElementById('pay-amt-'+p.id).value)||0}));
  const splitAmong = currentTrip.people.filter(p=>document.getElementById('split-chk-'+p.id).checked)
    .map(p=>({personId:p.id, amount:parseFloat(document.getElementById('split-amt-'+p.id).value)||0}));

  if(paidBy.length===0){ showToast('Marque quem pagou essa despesa.', true); return; }
  if(splitAmong.length===0){ showToast('Marque entre quem essa despesa deve ser dividida.', true); return; }

  const paidSum = Math.round(paidBy.reduce((s,p)=>s+p.amount,0)*100)/100;
  const splitSum = Math.round(splitAmong.reduce((s,p)=>s+p.amount,0)*100)/100;
  if(Math.abs(paidSum-amount)>0.02){ showToast(`A soma de quem pagou (${paidSum.toFixed(2)}) precisa bater com o valor total (${amount.toFixed(2)}).`, true); return; }
  if(Math.abs(splitSum-amount)>0.02){ showToast(`A soma da divisão (${splitSum.toFixed(2)}) precisa bater com o valor total (${amount.toFixed(2)}). Use "dividir igualmente" ou ajuste os valores.`, true); return; }

  let expense = currentTrip.expenses.find(e=>e.id===id);
  if(!expense){ expense = {id}; currentTrip.expenses.push(expense); }
  Object.assign(expense, {description,category,date,currency,amount,amountRef,paidBy,splitAmong,notes});
  await saveCurrentTrip();
  closeModal();
  renderSection();
}
async function removeExpense(id){
  if(!(await showConfirm('Remover esta despesa?'))) return;
  currentTrip.expenses = currentTrip.expenses.filter(e=>e.id!==id);
  await saveCurrentTrip();
  renderSection();
}

/* ---- Manual settlements (recording an actual payment made between two people) ---- */
function openSettlementModal(){
  const people = currentTrip.people;
  if(people.length<2){ showToast('Adicione ao menos duas pessoas para registrar um pagamento entre elas.', true); return; }
  document.getElementById('modal-root').innerHTML = `
  <div class="modal-bg" onclick="if(event.target===this) closeModal()">
    <div class="modal">
      <h2>🧾 Registrar pagamento</h2>
      <div class="row">
        <div class="field"><label>Quem pagou</label><select id="st-from">${people.map(p=>`<option value="${p.id}">${escapeHtml(p.name)}</option>`).join('')}</select></div>
        <div class="field"><label>Para quem</label><select id="st-to">${people.map((p,i)=>`<option value="${p.id}" ${i===1?'selected':''}>${escapeHtml(p.name)}</option>`).join('')}</select></div>
      </div>
      <div class="row">
        <div class="field"><label>Moeda</label>${currencyInputHtml('st-curr', refCurrency())}</div>
        <div class="field"><label>Valor</label><input id="st-amount" type="number" step="0.01"></div>
      </div>
      <div class="field"><label>Equivalente em ${refCurrency()}</label>
        <div style="display:flex;gap:6px;"><input id="st-amountref" type="number" step="0.01"><button type="button" class="btn ghost sm" onclick="convertSettlementAmount()">🔄 Converter</button></div>
      </div>
      <div class="row">
        <div class="field"><label>Data</label><input id="st-date" type="date" value="${new Date().toISOString().slice(0,10)}"></div>
        <div class="field"><label>Nota</label><input id="st-note" placeholder="Ex: Pix"></div>
      </div>
      <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:16px;">
        <button class="btn ghost" onclick="closeModal()">Cancelar</button>
        <button class="btn brass" onclick="saveSettlement()">Salvar</button>
      </div>
    </div>
  </div>`;
}
async function convertSettlementAmount(){
  const from = document.getElementById('st-curr').value.trim().toUpperCase();
  const to = refCurrency();
  const amount = parseFloat(document.getElementById('st-amount').value)||0;
  const result = await convertViaApi(from,to,amount);
  if(result!=null) document.getElementById('st-amountref').value = result.toFixed(2);
  else showToast('Conversão indisponível — preencha manualmente.', true);
}
async function saveSettlement(){
  const from = document.getElementById('st-from').value;
  const to = document.getElementById('st-to').value;
  const currency = document.getElementById('st-curr').value.trim().toUpperCase();
  const amount = parseFloat(document.getElementById('st-amount').value)||0;
  let amountRef = parseFloat(document.getElementById('st-amountref').value);
  const date = document.getElementById('st-date').value;
  const note = document.getElementById('st-note').value.trim();
  if(from===to){ showToast('Selecione duas pessoas diferentes.', true); return; }
  if(amount<=0){ showToast('Informe um valor maior que zero.', true); return; }
  if(currency===refCurrency()){
    if(isNaN(amountRef) || amountRef<=0) amountRef = amount;
  } else if(isNaN(amountRef) || amountRef<=0){
    const auto = await convertViaApi(currency, refCurrency(), amount);
    if(auto!=null){ amountRef = auto; }
    else { showToast(`Informe o valor equivalente em ${refCurrency()} antes de salvar.`, true); return; }
  }
  currentTrip.settlements.push({id:uid(), from, to, amount, currency, amountRef, date, note});
  await saveCurrentTrip();
  closeModal();
  renderSection();
}
async function removeSettlement(id){
  currentTrip.settlements = currentTrip.settlements.filter(s=>s.id!==id);
  await saveCurrentTrip();
  renderSection();
}
async function quickSettle(fromId,toId,amount){
  if(!(await showConfirm(`Registrar que ${personName(fromId)} pagou ${amount.toFixed(2)} ${refCurrency()} para ${personName(toId)}?`))) return;
  currentTrip.settlements.push({id:uid(), from:fromId, to:toId, amount, currency:refCurrency(), amountRef:amount, date:new Date().toISOString().slice(0,10), note:'Quitação sugerida'});
  await saveCurrentTrip();
  renderSection();
}

init();
</script>
