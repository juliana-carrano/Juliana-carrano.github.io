/* Duplicates the current trip as a starting template for a future one: keeps destinations,
   itinerary, bookings (with their attachments), documents and budget categories, but resets
   things that are specific to an actual past trip (expenses, settlements, weather cache, and
   done/actual progress) so it starts fresh. */
async function duplicateTrip(){
  const orig = tripsIndex.find(x=>x.id===currentTripId);
  const origData = currentTrip;
  showToast('Duplicando viagem...', false);
  const newId = uid();
  const destIdMap = {};
  const newDestinations = origData.destinations.map(d=>{
    const newDid = uid();
    destIdMap[d.id] = newDid;
    return {...d, id:newDid};
  });
  const newDays = origData.itinerary.days.map(day=>({
    date: day.date,
    destinationId: destIdMap[day.destinationId] || (newDestinations[0]?newDestinations[0].id:null),
    items: day.items.map(it=>({...it, id:uid()})),
  }));
  const newBookings = [];
  for(const b of (origData.bookings||[])){
    const newBid = uid();
    const nb = {...b, id:newBid, attachments:[]};
    for(const a of (b.attachments||[])){
      const f = await storGet('file:'+a.id);
      if(f){
        const newAid = uid();
        await storSet('file:'+newAid, f);
        nb.attachments.push({id:newAid, name:a.name, type:a.type});
      }
    }
    newBookings.push(nb);
  }
  const newDocuments = origData.documents.map(d=>({...d, id:uid(), done:false}));
  const newBudgetCats = origData.budget.categories.map(cat=>({...cat, id:uid(), actual:0}));
  const newPeople = origData.people.map(p=>({...p, id:uid()}));
  const newPacking = { items: origData.packing.items.filter(i=>!i.auto).map(i=>({...i, id:uid(), done:false})), weatherByDest:{} };

  const newData = {
    destinations: newDestinations,
    itinerary: { days: newDays },
    bookings: newBookings,
    documents: newDocuments,
    budget: { categories: newBudgetCats },
    packing: newPacking,
    people: newPeople,
    expenses: [],
    settlements: [],
  };
  tripsIndex.push({...orig, id:newId, name: orig.name+' (cópia)'});
  await saveTripsIndex();
  await storSet('trip-data:'+newId, newData);
  currentTripId = newId;
  currentTrip = newData;
  activeSection = 'dashboard';
  showToast('✅ Viagem duplicada! Ajuste as datas na aba Destinos se precisar.', false);
  render();
}

