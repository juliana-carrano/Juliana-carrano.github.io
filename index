          dtEnd = `${dateStr}T${String(endH).padStart(2,'0')}${sm.padStart(2,'0')}00`;
        }
      }
      const descParts = [];
      if(it.notes) descParts.push(it.notes);
      if(it.link) descParts.push('Link: '+it.link);
      if(it.needsReservation) descParts.push(it.reservationConfirmed?'Reserva confirmada':'Precisa reservar');
      lines.push('BEGIN:VEVENT');
      lines.push('UID:'+it.id+'@diariodebordo');
      lines.push('DTSTAMP:'+new Date().toISOString().replace(/[-:]/g,'').split('.')[0]+'Z');
      if(allDay){ lines.push('DTSTART;VALUE=DATE:'+dateStr); }
      else { lines.push('DTSTART:'+dtStart); lines.push('DTEND:'+dtEnd); }
      const catLabel = CATEGORY_LABELS[it.category] ? '['+CATEGORY_LABELS[it.category]+'] ' : '';
      lines.push('SUMMARY:'+icsEscape(catLabel+it.title));
      if(it.place) lines.push('LOCATION:'+icsEscape(it.place));
      if(descParts.length) lines.push('DESCRIPTION:'+icsEscape(descParts.join(' | ')));
      lines.push('END:VEVENT');
      count++;
    });
  });
  lines.push('END:VCALENDAR');
  if(count===0){ showToast('Ainda não há atividades no roteiro para exportar.', true); return; }
  const filename = `roteiro-${(t.name||'viagem').toLowerCase().replace(/[^a-z0-9]+/g,'-')}.ics`;
  triggerDownload(filename, lines.join('\r\n'), 'text/calendar;charset=utf-8');
  showToast(`📅 ${count} atividade(s) exportada(s) — abra o arquivo para importar no seu calendário.`, false);
}
