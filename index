<style>
  :root{
    --ink:#1F2E45;
    --ink-2:#2A3E5C;
    --cream:#F6EFE2;
    --cream-2:#EFE4CF;
    --paper:#FFFFFF;
    --brass:#C08A3E;
    --brass-dark:#9C6B26;
    --teal:#2F6B69;
    --teal-dark:#204B49;
    --rust:#9C4A2E;
    --text:#2B2620;
    --text-soft:#6B6355;
    --line:rgba(31,46,69,0.16);
    --shadow:0 8px 24px rgba(31,46,69,0.10);
    --radius:14px;
    --font-display:'Fraunces', serif;
    --font-body:'Inter', sans-serif;
    --font-mono:'IBM Plex Mono', monospace;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--cream);
    color:var(--text);
    font-family:var(--font-body);
    -webkit-font-smoothing:antialiased;
  }
  #app{min-height:100vh;display:flex;flex-direction:column;}

  /* ---------- Header / brand ---------- */
  .brandbar{
    background:var(--ink);
    color:var(--cream);
    padding:18px 24px 14px;
    display:flex;align-items:center;justify-content:space-between;
    flex-wrap:wrap;gap:10px;
  }
  .brand{display:flex;align-items:baseline;gap:10px;}
  .brand .mark{
    font-family:var(--font-display);font-weight:700;font-size:22px;letter-spacing:.3px;
  }
  .brand .tag{font-size:12px;color:#C7D2CB;font-family:var(--font-mono);letter-spacing:.5px;text-transform:uppercase;}
  .brandbar .stat{font-family:var(--font-mono);font-size:12px;color:#D9CBA3;}

  /* ---------- Trip tabs (boarding pass stubs) ---------- */
  .tabsrow{
    display:flex;gap:10px;padding:16px 24px 0;overflow-x:auto;
    background:linear-gradient(var(--ink), var(--ink) 55%, transparent 55%);
  }
  .tabsrow::-webkit-scrollbar{height:6px;}
  .tab{
    position:relative;
    flex:0 0 auto;
    background:var(--cream-2);
    color:var(--text);
    border:1px solid var(--line);
    border-bottom:none;
    border-radius:10px 10px 0 0;
    padding:10px 18px 16px;
    cursor:pointer;
    font-size:13px;
    min-width:150px;
    transition:transform .12s ease, background .15s ease;
  }
  .tab .t-name{font-family:var(--font-display);font-weight:600;font-size:15px;display:block;}
  .tab .t-dates{font-family:var(--font-mono);font-size:11px;color:var(--text-soft);}
  .tab.active{
    background:var(--paper);
    transform:translateY(2px);
    box-shadow:0 -2px 0 var(--brass) inset;
  }
  .tab.active:after{
    content:"";position:absolute;left:0;right:0;bottom:-1px;height:6px;background:var(--paper);
  }
  .tab .notch{
    position:absolute;bottom:-7px;width:14px;height:14px;border-radius:50%;background:var(--ink);
  }
  .tab .notch.l{left:-7px;} .tab .notch.r{right:-7px;}
  .tab-new{
    flex:0 0 auto;border:1.5px dashed rgba(246,239,226,0.55);color:var(--cream);
    background:transparent;border-radius:10px 10px 0 0;padding:10px 16px;font-family:var(--font-body);
    font-size:13px;cursor:pointer;min-width:120px;align-self:flex-start;
  }
  .tab-new:hover{background:rgba(246,239,226,0.08);}

  /* ---------- Trip header band ---------- */
  .tripband{
    background:var(--paper);
    border-bottom:1px solid var(--line);
    padding:18px 24px;
    display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:14px;
  }
  .tripband h1{font-family:var(--font-display);font-weight:700;font-size:26px;margin:0;color:var(--ink);}
  .tripband .dest{color:var(--teal-dark);font-family:var(--font-mono);font-size:12.5px;margin-top:2px;}
  .stampbadge{
    width:78px;height:78px;border-radius:50%;
    border:2.5px dashed var(--rust);
    color:var(--rust);
    display:flex;flex-direction:column;align-items:center;justify-content:center;
    transform:rotate(-8deg);
    font-family:var(--font-mono);
    flex:0 0 auto;
  }
  .stampbadge .n{font-size:22px;font-weight:600;line-height:1;}
  .stampbadge .l{font-size:8.5px;letter-spacing:.5px;text-transform:uppercase;margin-top:2px;}

  /* ---------- Section nav (luggage tag pills) ---------- */
  .navpills{
    display:flex;gap:8px;padding:14px 24px;flex-wrap:wrap;background:var(--cream);
    border-bottom:1px solid var(--line);
  }
  .pill{
    background:var(--paper);border:1px solid var(--line);border-radius:20px;
    padding:8px 16px;font-size:13px;cursor:pointer;color:var(--text);
    display:flex;align-items:center;gap:6px;transition:all .15s ease;
  }
  .pill:hover{border-color:var(--brass);}
  .pill.active{background:var(--ink);color:var(--cream);border-color:var(--ink);}

  /* ---------- Content ---------- */
  .content{flex:1;padding:22px 24px 60px;max-width:1180px;width:100%;margin:0 auto;}
  .card{
    background:var(--paper);border-radius:var(--radius);padding:20px 22px;
    box-shadow:var(--shadow);border:1px solid var(--line);margin-bottom:18px;position:relative;
  }
  .card:before,.card:after{
    content:"";position:absolute;top:8px;width:6px;height:6px;border-radius:50%;background:var(--brass);opacity:.55;
  }
  .card:before{left:8px;} .card:after{right:8px;}
  .card h2{font-family:var(--font-display);font-size:19px;margin:0 0 12px;color:var(--ink);font-weight:600;}
  .card h3{font-family:var(--font-display);font-size:16px;margin:0 0 8px;color:var(--ink);font-weight:600;}
  .grid2{display:grid;grid-template-columns:1fr 1fr;gap:18px;}
  .grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;}
  @media(max-width:820px){.grid2,.grid3{grid-template-columns:1fr;}}

  label{font-size:12px;color:var(--text-soft);display:block;margin-bottom:4px;font-family:var(--font-body);}
  input,select,textarea{
    width:100%;padding:8px 10px;border:1px solid var(--line);border-radius:8px;
    font-family:var(--font-body);font-size:13.5px;background:var(--cream);color:var(--text);
  }
  input:focus,select:focus,textarea:focus{outline:2px solid var(--brass);outline-offset:1px;}
  textarea{resize:vertical;min-height:44px;}
  .field{margin-bottom:10px;}
  .row{display:flex;gap:10px;flex-wrap:wrap;}
  .row > .field{flex:1;min-width:120px;}

  .btn{
    background:var(--ink);color:var(--cream);border:none;border-radius:8px;padding:9px 16px;
    font-size:13px;cursor:pointer;font-family:var(--font-body);font-weight:600;transition:background .15s;
  }
  .btn:hover{background:var(--ink-2);}
  .btn.brass{background:var(--brass);color:#2B2210;}
  .btn.brass:hover{background:var(--brass-dark);color:var(--cream);}
  .btn.teal{background:var(--teal);color:var(--cream);}
  .btn.teal:hover{background:var(--teal-dark);}
  .btn.ghost{background:transparent;color:var(--ink);border:1px solid var(--line);}
  .btn.ghost:hover{border-color:var(--ink);}
  .btn.danger{background:transparent;color:var(--rust);border:1px solid var(--rust);}
  .btn.danger:hover{background:var(--rust);color:#fff;}
  .btn.sm{padding:5px 10px;font-size:12px;}
  .iconbtn{background:none;border:none;cursor:pointer;font-size:15px;color:var(--text-soft);padding:2px 6px;}
  .iconbtn:hover{color:var(--rust);}

  .empty{
    text-align:center;padding:50px 20px;color:var(--text-soft);
  }
  .empty .big{font-size:40px;margin-bottom:10px;}

  /* Itinerary */
  .catchip{
    display:inline-block;font-size:10.5px;padding:1px 7px;border-radius:10px;background:var(--teal);color:#fff;
    margin-right:6px;font-family:var(--font-mono);
  }
  .resbadge{
    display:inline-block;font-size:10.5px;padding:1px 7px;border-radius:10px;margin-right:6px;font-family:var(--font-mono);
  }
  .resbadge.pending{background:#F1DCC9;color:var(--rust);}
  .resbadge.confirmed{background:#DCEAE7;color:var(--teal-dark);}
  .item-actions{display:flex;gap:2px;}

  /* Trello-style horizontal board: one scrollable column per day */
  .board{display:flex;gap:14px;overflow-x:auto;padding:4px 4px 16px;align-items:flex-start;}
  .board-col{
    flex:0 0 296px;background:var(--cream-2);border-radius:14px;padding:12px;
    display:flex;flex-direction:column;max-height:74vh;
  }
  .board-col-head{margin-bottom:8px;flex:0 0 auto;}
  .board-col-head .d-title{font-family:var(--font-display);font-weight:700;color:var(--ink);font-size:15px;}
  .board-col-head .d-sub{font-family:var(--font-mono);font-size:10.5px;color:var(--text-soft);display:block;margin-top:2px;}
  .board-col-head select{width:100%;font-size:11.5px;padding:4px 6px;margin-top:6px;}
  .board-col-count{font-family:var(--font-mono);font-size:10.5px;color:var(--text-soft);}
  .board-col-body{display:flex;flex-direction:column;gap:8px;overflow-y:auto;padding:2px 2px 4px;flex:1;min-height:20px;}
  .board-card{
    background:var(--paper);border-radius:10px;padding:9px 11px;box-shadow:0 2px 6px rgba(31,46,69,0.10);cursor:pointer;
  }
  .board-card:hover{box-shadow:0 4px 10px rgba(31,46,69,0.16);}
  .board-card-time{font-family:var(--font-mono);font-size:11px;color:var(--teal-dark);font-weight:700;}
  .board-card-time .end{color:var(--text-soft);font-weight:400;}
  .board-card-title{font-weight:600;font-size:13px;margin-top:2px;line-height:1.25;}
  .board-card-meta{font-size:10.5px;color:var(--text-soft);margin-top:4px;line-height:1.5;}
  .board-card-actions{display:flex;gap:2px;justify-content:flex-end;margin-top:4px;}
  .board-add-btn{margin-top:8px;flex:0 0 auto;width:100%;}

  /* Bookings */
  .booking-card{
    border:1px solid var(--line);border-radius:12px;padding:14px 16px;margin-bottom:12px;
    display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;
  }
  .booking-card .code{font-family:var(--font-mono);background:var(--cream-2);padding:2px 8px;border-radius:6px;font-size:12px;}

  /* Map */
  #mapview{height:440px;border-radius:12px;border:1px solid var(--line);}
  .distlist{font-family:var(--font-mono);font-size:12.5px;line-height:1.9;}
  .banner{
    background:var(--brass);color:#2B2210;padding:8px 14px;border-radius:8px;font-size:13px;
    display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;
  }

  /* Currency / timezone */
  .bigresult{font-family:var(--font-mono);font-size:26px;color:var(--ink);font-weight:600;}
  .tzcard{background:var(--cream-2);border-radius:10px;padding:14px;text-align:center;}
  .tzcard .time{font-family:var(--font-mono);font-size:24px;color:var(--ink);}
  .tzcard .place{font-family:var(--font-display);font-weight:600;}
  .tzcard .off{font-size:12px;color:var(--text-soft);}

  /* checklist */
  .checkrow{display:flex;align-items:center;gap:10px;padding:7px 0;border-bottom:1px solid var(--line);}
  .checkrow:last-child{border-bottom:none;}
  .checkrow input[type=checkbox]{width:18px;height:18px;flex:0 0 auto;accent-color:var(--teal);}
  .checkrow.done .label{text-decoration:line-through;color:var(--text-soft);}
  .progress-wrap{background:var(--cream-2);border-radius:8px;height:8px;overflow:hidden;margin:8px 0 14px;}
  .progress-bar{height:100%;background:var(--teal);transition:width .3s ease;}

  /* budget */
  table{width:100%;border-collapse:collapse;font-size:13.5px;}
  th,td{text-align:left;padding:8px 6px;border-bottom:1px solid var(--line);}
  th{font-family:var(--font-mono);font-size:11px;text-transform:uppercase;color:var(--text-soft);font-weight:600;}
  td input{padding:5px 7px;font-size:13px;}
  .totalrow td{font-weight:700;font-family:var(--font-mono);}
  .over{color:var(--rust);}
  .under{color:var(--teal-dark);}

  .modal-bg{
    position:fixed;inset:0;background:rgba(31,46,69,0.55);display:flex;align-items:center;justify-content:center;
    z-index:50;padding:20px;
  }
  .modal{background:var(--paper);border-radius:var(--radius);padding:24px;max-width:480px;width:100%;max-height:88vh;overflow-y:auto;}
  .modal h2{font-family:var(--font-display);margin-top:0;}
  .weathergrid{display:flex;gap:10px;overflow-x:auto;padding-bottom:6px;}
  .wday{background:var(--cream-2);border-radius:10px;padding:10px 12px;min-width:78px;text-align:center;flex:0 0 auto;}
  .wday .d{font-size:11px;color:var(--text-soft);font-family:var(--font-mono);}
  .wday .t{font-family:var(--font-mono);font-weight:600;font-size:14px;margin-top:4px;}
  .note{font-size:12px;color:var(--text-soft);margin-top:8px;}
  ::selection{background:var(--brass);color:#fff;}
</style>
</head>
