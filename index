/* Leaflet's default marker icon references relative image paths that break depending on how
   the CSS/JS were loaded; point them explicitly at the CDN so pins never show as broken images. */
if(window.L){
  delete L.Icon.Default.prototype._getIconUrl;
  L.Icon.Default.mergeOptions({
    iconRetinaUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/images/marker-icon-2x.png',
