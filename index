    return;
  }
  const rows = [['Tipo','Descrição','Categoria','Data','Moeda','Valor','Valor em '+refCurrency(),'Pago por','Dividido entre / Para quem','Notas']];
  currentTrip.expenses.forEach(e=>{
    const payers = (e.paidBy||[]).map(p=>`${personName(p.personId)} (${(+p.amount).toFixed(2)})`).join('; ');
    const among = (e.splitAmong||[]).map(s=>`${personName(s.personId)} (${(+s.amount).toFixed(2)})`).join('; ');
    rows.push(['Despesa', e.description||'', e.category||'', e.date||'', e.currency||'', (+e.amount||0).toFixed(2), (+e.amountRef||0).toFixed(2), payers, among, e.notes||'']);
  });
  currentTrip.settlements.forEach(s=>{
    rows.push(['Pagamento', `${personName(s.from)} pagou ${personName(s.to)}`, '', s.date||'', s.currency||'', (+s.amount||0).toFixed(2), (+s.amountRef||0).toFixed(2), personName(s.from), personName(s.to), s.note||'']);
  });
  const csv = rows.map(r=>r.map(csvEscape).join(',')).join('\r\n');
  const filename = `despesas-${(t.name||'viagem').toLowerCase().replace(/[^a-z0-9]+/g,'-')}.csv`;
  triggerDownload(filename, '\uFEFF'+csv, 'text/csv;charset=utf-8'); // BOM para o Excel abrir acentos corretamente
  showToast('📊 Despesas exportadas em CSV!', false);
}

