async function removeDestination(id){
  if(currentTrip.destinations.length<=1){ showToast('A viagem precisa de ao menos um destino.', true); return; }
  if(!(await showConfirm('Remover este destino? Os dias do roteiro ligados a ele passam a usar outro destino automaticamente.'))) return;
  currentTrip.destinations = currentTrip.destinations.filter(d=>d.id!==id);
  currentTrip.itinerary.days.forEach(day=>{ if(day.destinationId===id) day.destinationId=null; });
  if(currentTrip.packing.weatherByDest) delete currentTrip.packing.weatherByDest[id];
  recomputeTripRange();
  await saveTripsIndex();
  await saveCurrentTrip();
  render();
}

