async function exportBackup(){
  showToast('Preparando backup...', false);
  const backup = {version:1, exportedAt:new Date().toISOString(), tripsIndex, tripData:{}, files:{}};
  for(const t of tripsIndex){
    const data = await storGet('trip-data:'+t.id);
    if(!data) continue;
    backup.tripData[t.id] = data;
    for(const b of (data.bookings||[])){
      if(b.hasFile){
        const f = await storGet('file:'+b.id);
        if(f) backup.files[b.id] = f;
      }
    }
  }
  const blob = new Blob([JSON.stringify(backup)], {type:'application/json'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `diario-de-bordo-backup-${new Date().toISOString().slice(0,10)}.json`;
  document.body.appendChild(a); a.click(); a.remove();
  URL.revokeObjectURL(url);
  showToast('✅ Backup exportado! Guarde esse arquivo em local seguro.', false);
}
function handleBackupFileSelected(input){
  const file = input.files[0];
  if(!file) return;
  document.getElementById('backup-import-msg').textContent = 'Importando...';
  importBackupFromFile(file);
}
async function importBackupFromFile(file){
  const msg = document.getElementById('backup-import-msg');
  try{
    const text = await file.text();
    const backup = JSON.parse(text);
    if(!backup || !Array.isArray(backup.tripsIndex) || !backup.tripData){
      msg.textContent = 'Esse arquivo não parece ser um backup válido deste app.';
      return;
    }
    let imported = 0, lastNewId = null;
    for(const tMeta of backup.tripsIndex){
      const data = backup.tripData[tMeta.id];
      if(!data) continue;
      const newId = uid();
      tripsIndex.push({...tMeta, id:newId});
      for(const b of (data.bookings||[])){
        if(b.hasFile && backup.files && backup.files[b.id]){
          await storSet('file:'+b.id, backup.files[b.id]);
        }
      }
      await storSet('trip-data:'+newId, data);
      lastNewId = newId;
      imported++;
    }
    if(imported===0){ msg.textContent = 'Nenhuma viagem encontrada nesse arquivo.'; return; }
    await saveTripsIndex();
    msg.textContent = `✅ ${imported} viagem${imported!==1?'ns':''} importada${imported!==1?'s':''} com sucesso!`;
    showToast(`${imported} viagem(ns) importada(s)!`, false);
    if(lastNewId){
      currentTripId = lastNewId;
      currentTrip = ensureTripShape(await storGet('trip-data:'+lastNewId), tripsIndex.find(t=>t.id===lastNewId));
    }
    closeModal();
    render();
  }catch(e){
    console.error('importBackupFromFile falhou', e);
    msg.textContent = 'Não foi possível ler esse arquivo. Verifique se é um .json exportado por este app.';
  }
}

