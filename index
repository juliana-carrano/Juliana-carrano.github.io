function doTimezone(){
  const from = document.getElementById('tz-from').value;
  const to = document.getElementById('tz-to').value;
  const resDiv = document.getElementById('tz-result');
  const now = new Date();
  function info(tz){
    const time = now.toLocaleTimeString('pt-BR',{timeZone:tz, hour:'2-digit',minute:'2-digit'});
    const date = now.toLocaleDateString('pt-BR',{timeZone:tz, day:'2-digit',month:'2-digit'});
    const parts = new Intl.DateTimeFormat('en-US',{timeZone:tz,timeZoneName:'shortOffset'}).formatToParts(now);
    const offsetStr = (parts.find(p=>p.type==='timeZoneName')||{}).value || '';
    return {time,date,offsetStr};
  }
  const a = info(from), b = info(to);
  function offsetHours(s){
    const m = (s||'').match(/GMT([+-]\d+)(?::(\d+))?/);
    if(!m) return 0;
    return parseFloat(m[1]) + (m[2]?parseFloat(m[2])/60*Math.sign(parseFloat(m[1])||1):0);
  }
  const diff = offsetHours(b.offsetStr) - offsetHours(a.offsetStr);
  const diffLabel = diff===0 ? 'Mesmo horário' : (diff>0? `Destino ${Math.abs(diff)}h à frente` : `Destino ${Math.abs(diff)}h atrás`);
  resDiv.innerHTML = `
    <div class="row">
      <div class="tzcard"><div class="place">Você</div><div class="time">${a.time}</div><div class="off">${a.date} · ${a.offsetStr}</div></div>
      <div class="tzcard"><div class="place">Destino</div><div class="time">${b.time}</div><div class="off">${b.date} · ${b.offsetStr}</div></div>
    </div>
    <div class="note" style="margin-top:10px;text-align:center;font-size:13px;">${diffLabel}</div>
  `;
}

