        currencyRateCache[from.toUpperCase()+'_'+to.toUpperCase()] = {rate, date:data.date, manual:false};
        saveCurrencyCache();
        resDiv.innerHTML = `<div class="bigresult">${to.toUpperCase()} ${converted.toFixed(2)}</div>
          <div class="note">1 ${from.toUpperCase()} = ${rate.toFixed(4)} ${to.toUpperCase()} · atualizado em ${data.date}</div>
          <button type="button" class="btn ghost sm" style="margin-top:8px;" onclick="renderManualConvertForm()">✏️ Informar cotação manualmente</button>`;
        return;
      }
    }catch(e){ console.error('doConvert falhou', e); /* tenta a próxima fonte */ }
  }
  renderManualConvertForm();
}
