function generateAllPackingSuggestions(){
  const weatherByDest = currentTrip.packing.weatherByDest || {};
  const allDays = Object.values(weatherByDest).flatMap(w=>w.days);
  if(!allDays.length){ showToast('Busque a previsão do tempo de ao menos um destino primeiro.', true); return; }
  generatePackingSuggestions({days:allDays});
  saveCurrentTrip();
  renderSection();
}
function generatePackingSuggestions(weather){
  const maxes = weather.days.map(d=>d.tmax);
  const mins = weather.days.map(d=>d.tmin);
  const avgMax = maxes.reduce((s,v)=>s+v,0)/maxes.length;
  const avgMin = mins.reduce((s,v)=>s+v,0)/mins.length;
  const spread = Math.max(...maxes) - Math.min(...mins);
  const rainDays = weather.days.filter(d=>d.rain!=null && d.rain>=40).length;
  const tripDays = weather.days.length;
  let suggestions = ['Documentos de viagem e cópias', 'Carregador e adaptador de tomada', 'Kit de higiene pessoal', 'Remédios de uso pessoal'];
  if(avgMax>=27){ suggestions.push('Roupas leves e respiráveis','Protetor solar','Óculos de sol','Chapéu/boné','Sandálias'); }
  else if(avgMax>=18){ suggestions.push('Camadas leves (camiseta + casaco leve)','Calça confortável'); }
  else { suggestions.push('Casaco pesado / corta-vento','Cachecol, gorro e luvas','Roupas térmicas'); }
  if(avgMin<=10){ suggestions.push('Meias térmicas','Roupa de dormir quentinha'); }
  if(rainDays>0){ suggestions.push('Guarda-chuva compacto','Capa de chuva','Calçado impermeável'); }
  if(spread>=15){ suggestions.push('Roupas em camadas (o clima varia bastante entre os destinos/dias)'); }
  const outfitCount = Math.max(tripDays, Math.ceil(tripDays*1.2));
  suggestions.push(`Roupas íntimas e meias para ${outfitCount} dias`, `Looks para ${tripDays} dias (considere repetir peças)`);
  // merge: keep existing custom (non-auto) items, replace auto-generated ones
  const custom = currentTrip.packing.items.filter(i=>!i.auto);
  const autoItems = [...new Set(suggestions)].map(label=>({id:uid(), label, done:false, auto:true}));
  currentTrip.packing.items = [...autoItems, ...custom];
}
