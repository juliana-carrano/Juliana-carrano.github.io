      <span class="label">🆕 ${escapeHtml(f.name)} <span style="color:var(--text-soft);">(será salvo)</span></span>
      <button type="button" class="iconbtn" style="margin-left:auto;" onclick="removePendingAttachment(${idx})" title="Remover">🗑️</button>
    </div>`).join('');
  const combined = existingHtml+pendingHtml;
  list.innerHTML = combined || '<div class="note">Nenhum anexo ainda.</div>';
}
async function onBookingFileChange(input){
  const files = Array.from(input.files||[]);
  for(const file of files){
    if(file.size > MAX_FILE_BYTES){
      showToast(`"${file.name}" é muito grande (máx. ~3,5MB) — ignorado.`, true);
      continue;
    }
    try{
      const base64 = await new Promise((resolve,reject)=>{
        const reader = new FileReader();
        reader.onload = ()=>resolve(reader.result.split(',')[1]);
        reader.onerror = reject;
        reader.readAsDataURL(file);
      });
      pendingBookingFiles.push({name:file.name, type:file.type||'application/pdf', data:base64});
    }catch(e){ showToast(`Não foi possível ler "${file.name}".`, true); }
  }
  input.value = '';
  const editing = currentTrip.bookings.find(b=>b.id===currentBookingModalId);
  renderAttachmentsList(editing ? editing.attachments : []);
}
function removePendingAttachment(idx){
  pendingBookingFiles.splice(idx,1);
  const editing = currentTrip.bookings.find(b=>b.id===currentBookingModalId);
  renderAttachmentsList(editing ? editing.attachments : []);
}
async function removeExistingAttachment(attId){
  if(!(await showConfirm('Remover este anexo?'))) return;
  await storDelete('file:'+attId);
  const booking = currentTrip.bookings.find(b=>b.id===currentBookingModalId);
  if(booking) booking.attachments = (booking.attachments||[]).filter(a=>a.id!==attId);
  await saveCurrentTrip();
  renderAttachmentsList(booking ? booking.attachments : []);
}
async function saveBooking(id){
  const type = document.getElementById('bk-type').value;
  const code = document.getElementById('bk-code').value.trim();
  const name = document.getElementById('bk-name').value.trim();
  const checkin = document.getElementById('bk-in').value;
  const checkout = document.getElementById('bk-out').value;
  const link = document.getElementById('bk-link').value.trim();
  const notes = document.getElementById('bk-notes').value.trim();
  if(!name){ showToast('Dê um nome para a reserva.', true); return; }
  let booking = currentTrip.bookings.find(b=>b.id===id);
  if(!booking){ booking = {id, attachments:[]}; currentTrip.bookings.push(booking); }
  if(!booking.attachments) booking.attachments = [];
  Object.assign(booking, {type,code,name,checkin,checkout,link,notes});
  for(const f of pendingBookingFiles){
    const attId = uid();
    const ok = await storSet('file:'+attId, f);
    if(ok) booking.attachments.push({id:attId, name:f.name, type:f.type});
    else showToast(`Não foi possível salvar o anexo "${f.name}".`, true);
  }
  pendingBookingFiles = [];
  await saveCurrentTrip();
  closeModal();
  renderSection();
}
async function viewBookingFile(attId){
  const rec = await storGet('file:'+attId);
  if(!rec){ showToast('Arquivo não encontrado — talvez tenha sido removido.', true); return; }
  const a = document.createElement('a');
  a.href = `data:${rec.type};base64,${rec.data}`;
  a.download = rec.name;
  a.target = '_blank';
  document.body.appendChild(a);
  a.click();
  a.remove();
}
async function removeBooking(id){
  const b = currentTrip.bookings.find(x=>x.id===id);
  if(b){ for(const a of (b.attachments||[])) await storDelete('file:'+a.id); }
  currentTrip.bookings = currentTrip.bookings.filter(x=>x.id!==id);
  await saveCurrentTrip();
  renderSection();
}

