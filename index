const PRIORITY_META = {
  alta: {icon:'🔴', label:'Alta', weight:0},
  media: {icon:'🟡', label:'Média', weight:1},
  baixa: {icon:'🟢', label:'Baixa', weight:2},
};
function sortDocuments(docs){
  const pending = docs.filter(d=>!d.done).sort((a,b)=>{
    const pa = a.priority ? PRIORITY_META[a.priority].weight : 3;
    const pb = b.priority ? PRIORITY_META[b.priority].weight : 3;
    if(pa!==pb) return pa-pb;
    const da = a.dueDate || '9999-12-31', db = b.dueDate || '9999-12-31';
    return da.localeCompare(db);
  });
  const done = docs.filter(d=>d.done);
  return [...pending, ...done];
}
function dueDateBadgeHtml(d){
  if(!d.dueDate) return '';
  if(d.done) return `<span class="note" style="font-family:var(--font-mono);font-size:11px;margin-left:6px;">${fmtDateShort(d.dueDate)}</span>`;
  const today = new Date(); today.setHours(0,0,0,0);
  const due = new Date(d.dueDate+'T00:00:00');
  const diffDays = Math.round((due-today)/86400000);
  let text, urgent = false;
  if(diffDays<0){ text = `atrasado desde ${fmtDateShort(d.dueDate)}`; urgent=true; }
  else if(diffDays===0){ text = 'vence hoje'; urgent=true; }
  else if(diffDays<=3){ text = `vence em ${diffDays} dia${diffDays!==1?'s':''}`; urgent=true; }
  else { text = `até ${fmtDateShort(d.dueDate)}`; }
  return `<span class="resbadge ${urgent?'pending':'confirmed'}" style="font-family:var(--font-mono);">${text}</span>`;
}
function priorityTagHtml(p){
  if(!p || !PRIORITY_META[p]) return '';
