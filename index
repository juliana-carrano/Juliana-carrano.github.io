/* ================= EXPENSE SPLITTING (Splitwise-style) ================= */
function personName(id){ const p=currentTrip.people.find(x=>x.id===id); return p?p.name:'(pessoa removida)'; }
function personColor(id){ const i=currentTrip.people.findIndex(x=>x.id===id); return i>=0?TRIP_COLORS[i%TRIP_COLORS.length]:'#999'; }
function refCurrency(){ const t=tripsIndex.find(x=>x.id===currentTripId); return t?t.currency:'BRL'; }

/* Converts a portion of an expense's original-currency amount into the trip's reference
   currency, using the ratio between the expense's stored total and its converted total. */
function toRefPortion(portionAmount, expense){
  if(!expense.amount) return 0;
  const rate = (expense.amountRef||0) / expense.amount;
  return portionAmount * rate;
}
function computeBalances(){
  const balances = {};
  currentTrip.people.forEach(p=>{ balances[p.id]=0; });
  currentTrip.expenses.forEach(e=>{
    (e.paidBy||[]).forEach(p=>{ balances[p.personId] = (balances[p.personId]||0) + toRefPortion(p.amount,e); });
    (e.splitAmong||[]).forEach(s=>{ balances[s.personId] = (balances[s.personId]||0) - toRefPortion(s.amount,e); });
  });
  currentTrip.settlements.forEach(s=>{
    balances[s.from] = (balances[s.from]||0) + (+s.amountRef||0);
    balances[s.to] = (balances[s.to]||0) - (+s.amountRef||0);
  });
  return balances;
}
/* Native (non-converted) balance per person per currency actually used — lets someone see
   "you're owed 50 USD and owe 30 BRL" instead of only one blended number. */
function computeNativeBalancesByCurrency(){
  const result = {};
  currentTrip.people.forEach(p=>{ result[p.id] = {}; });
  currentTrip.expenses.forEach(e=>{
    const cur = e.currency;
    (e.paidBy||[]).forEach(p=>{
      result[p.personId] = result[p.personId] || {};
      result[p.personId][cur] = (result[p.personId][cur]||0) + p.amount;
    });
    (e.splitAmong||[]).forEach(s=>{
      result[s.personId] = result[s.personId] || {};
      result[s.personId][cur] = (result[s.personId][cur]||0) - s.amount;
    });
  });
  currentTrip.settlements.forEach(s=>{
    const cur = s.currency;
    result[s.from] = result[s.from] || {};
    result[s.from][cur] = (result[s.from][cur]||0) + (+s.amount||0);
    result[s.to] = result[s.to] || {};
    result[s.to][cur] = (result[s.to][cur]||0) - (+s.amount||0);
  });
  return result;
}
/* Detects expenses/settlements broken by the old amountRef-defaults-to-zero bug so they can be
   repaired in one click instead of the person having to re-enter each one by hand. */
function hasBrokenConversions(){
  const ref = refCurrency();
  return currentTrip.expenses.some(e=>e.currency!==ref && (!e.amountRef || e.amountRef<=0)) ||
         currentTrip.settlements.some(s=>s.currency!==ref && (!s.amountRef || s.amountRef<=0));
}
async function repairBrokenConversions(){
  const ref = refCurrency();
  let fixed=0, failed=0;
  for(const e of currentTrip.expenses){
    if(e.currency!==ref && (!e.amountRef || e.amountRef<=0)){
      const converted = await convertViaApi(e.currency, ref, e.amount);
      if(converted!=null){ e.amountRef = converted; fixed++; } else failed++;
    }
  }
  for(const s of currentTrip.settlements){
    if(s.currency!==ref && (!s.amountRef || s.amountRef<=0)){
      const converted = await convertViaApi(s.currency, ref, s.amount);
      if(converted!=null){ s.amountRef = converted; fixed++; } else failed++;
    }
  }
  if(fixed>0) await saveCurrentTrip();
  showToast(fixed>0 ? `✅ ${fixed} valor(es) corrigido(s).` : 'Não foi possível corrigir agora — tente de novo mais tarde.', fixed===0);
  renderSection();
}
/* Minimal-transaction debt simplification, same approach Splitwise uses. */
function simplifyDebts(balances){
  const creditors=[], debtors=[];
  Object.entries(balances).forEach(([id,amt])=>{
    if(amt>0.01) creditors.push({id,amt});
    else if(amt<-0.01) debtors.push({id,amt:-amt});
  });
  creditors.sort((a,b)=>b.amt-a.amt);
  debtors.sort((a,b)=>b.amt-a.amt);
  const transactions=[];
  let i=0,j=0;
  while(i<debtors.length && j<creditors.length){
    const pay = Math.min(debtors[i].amt, creditors[j].amt);
    if(pay>0.01) transactions.push({from:debtors[i].id, to:creditors[j].id, amount:pay});
    debtors[i].amt -= pay; creditors[j].amt -= pay;
    if(debtors[i].amt<0.01) i++;
    if(creditors[j].amt<0.01) j++;
  }
  return transactions;
}
async function convertViaApi(from,to,amount){
  if(from.toLowerCase()===to.toLowerCase()) return amount;
  const f=from.toLowerCase(), t=to.toLowerCase();
  const urls = [
    `https://cdn.jsdelivr.net/npm/@fawazahmed0/currency-api@latest/v1/currencies/${f}.json`,
    `https://latest.currency-api.pages.dev/v1/currencies/${f}.json`
  ];
  for(const url of urls){
    try{
      const res = await fetch(url);
      if(!res.ok) continue;
      const data = await res.json();
      const rate = data[f] && data[f][t];
      if(rate!=null) return amount*rate;
    }catch(e){ /* tenta a próxima fonte */ }
  }
  return null;
}
/* State for the "view balances in another currency" switcher and the "today's rate" lookups
   used to annotate native-currency balances with a live reference-currency equivalent. */
let splittingDisplayCurrency = null; // null = usa a moeda de referência da viagem
let splittingDisplayRate = 1;
let todayConversionRates = {}; // 'USD_BRL' -> rate (sessão atual)
function getBestKnownRate(from,to){
  if(from.toUpperCase()===to.toUpperCase()) return 1;
  const key = from.toUpperCase()+'_'+to.toUpperCase();
  if(todayConversionRates[key]!=null) return todayConversionRates[key];
  if(currencyRateCache[key]) return currencyRateCache[key].rate;
  return null;
}
async function refreshTodayConversions(){
  const ref = refCurrency();
  const currencies = new Set();
  currentTrip.expenses.forEach(e=>{ if(e.currency && e.currency!==ref) currencies.add(e.currency); });
  currentTrip.settlements.forEach(s=>{ if(s.currency && s.currency!==ref) currencies.add(s.currency); });
  if(currencies.size===0){ showToast('Não há despesas em outra moeda nesta viagem.', false); return; }
  showToast('Buscando cotações de hoje...', false);
  let ok=0;
  for(const cur of currencies){
    const rate = await convertViaApi(cur, ref, 1);
    if(rate!=null){
      todayConversionRates[cur.toUpperCase()+'_'+ref.toUpperCase()] = rate;
      currencyRateCache[cur.toUpperCase()+'_'+ref.toUpperCase()] = {rate, date:new Date().toISOString().slice(0,10), manual:false};
      ok++;
    }
  }
  if(ok>0) saveCurrencyCache();
  showToast(ok>0 ? `✅ Cotações de hoje atualizadas (${ok}).` : 'Não foi possível buscar agora — tente novamente mais tarde.', ok===0);
  renderSection();
}
async function changeSplittingDisplayCurrency(newCurrency){
  const ref = refCurrency();
  if(newCurrency===ref){ splittingDisplayCurrency=null; splittingDisplayRate=1; renderSection(); return; }
  showToast('Buscando cotação...', false);
  const rate = await convertViaApi(ref, newCurrency, 1);
  if(rate==null){
    showToast('Não foi possível converter agora — mostrando na moeda de referência.', true);
    splittingDisplayCurrency=null; splittingDisplayRate=1;
  } else {
    splittingDisplayCurrency = newCurrency;
    splittingDisplayRate = rate;
    currencyRateCache[ref.toUpperCase()+'_'+newCurrency.toUpperCase()] = {rate, date:new Date().toISOString().slice(0,10), manual:false};
    saveCurrencyCache();
  }
  renderSection();
}

