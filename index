/* Replacement for window.confirm(), which appears to be silently suppressed in this artifact's
   sandbox (no allow-modals) — it was returning false immediately without ever prompting,
   quietly blocking every delete/confirm action in the app. This appends its own overlay
   directly to <body> (independent of #modal-root) so it stacks above whatever modal, if any,
   is already open, without disturbing it. Usage: if(!(await showConfirm('...'))) return; */
function showConfirm(message){
  return new Promise(resolve=>{
    const overlay = document.createElement('div');
    overlay.className = 'modal-bg';
    overlay.style.zIndex = '300';
    overlay.innerHTML = `
      <div class="modal" style="max-width:420px;">
        <p style="margin:0 0 20px;font-size:14.5px;line-height:1.5;">${escapeHtml(message)}</p>
        <div style="display:flex;justify-content:flex-end;gap:10px;">
          <button type="button" class="btn ghost" id="confirm-cancel-btn">Cancelar</button>
          <button type="button" class="btn danger" id="confirm-ok-btn">Confirmar</button>
        </div>
      </div>`;
    document.body.appendChild(overlay);
    function cleanup(val){ overlay.remove(); resolve(val); }
    overlay.addEventListener('click', (e)=>{ if(e.target===overlay) cleanup(false); });
    overlay.querySelector('#confirm-cancel-btn').addEventListener('click', ()=>cleanup(false));
    overlay.querySelector('#confirm-ok-btn').addEventListener('click', ()=>cleanup(true));
  });
}

/* Country -> city picker (works fully offline). prefix matches the ids used in each modal:
   'nt' (new trip), 'et' unused, 'dt' (destination). Auto-fills lat/lng, timezone and the name field. */
/* Geocodes any place name or full address (e.g. a hotel address) worldwide, trying two
   independent free providers in sequence so a single provider hiccup doesn't block the search.
   nameId is optional: if given and currently empty, it gets filled with the found place name. */
async function geocodeInto(queryId, latId, lngId, msgId, nameId){
  const q = document.getElementById(queryId).value.trim();
  const msg = document.getElementById(msgId);
  if(!q){ msg.textContent='Digite uma cidade ou endereço primeiro.'; return; }
  msg.textContent = 'Buscando...';

  // Provedor 1: Open-Meteo — ótimo para nomes de cidades
  try{
    const data = await fetchJsonRobust('https://geocoding-api.open-meteo.com/v1/search?count=1&language=pt&format=json&name='+encodeURIComponent(q));
    if(data && data.results && data.results[0]){
      const r = data.results[0];
      document.getElementById(latId).value = r.latitude.toFixed(5);
      document.getElementById(lngId).value = r.longitude.toFixed(5);
      const label = [r.name,r.admin1,r.country].filter(Boolean).join(', ');
      msg.textContent = '📍 Encontrado: '+label;
      if(nameId){ const nEl=document.getElementById(nameId); if(nEl && !nEl.value.trim()) nEl.value = r.name; }
      return;
    }
  }catch(e){ /* tenta o próximo provedor */ }

  // Provedor 2: Photon/Komoot — melhor para endereços completos (ex: endereço de um hotel)
  try{
    const data = await fetchJsonRobust('https://photon.komoot.io/api/?limit=1&lang=pt&q='+encodeURIComponent(q));
    const f = data && data.features && data.features[0];
    if(f && f.geometry && f.geometry.coordinates){
      const [lng,lat] = f.geometry.coordinates;
      document.getElementById(latId).value = lat.toFixed(5);
      document.getElementById(lngId).value = lng.toFixed(5);
      const p = f.properties||{};
      const label = [p.name,p.city,p.state,p.country].filter(Boolean).join(', ');
      msg.textContent = '📍 Encontrado: '+(label||q);
      if(nameId){ const nEl=document.getElementById(nameId); if(nEl && !nEl.value.trim()) nEl.value = p.name||p.city||q; }
      return;
    }
  }catch(e){ /* segue para o botão do Google Maps abaixo */ }

  msg.textContent = 'Não encontrado por aqui agora — use o botão "Abrir no Google Maps" abaixo para achar qualquer lugar do mundo e copiar as coordenadas de lá.';
}
/* Opens Google Maps' own (much larger) place database in a new tab so literally any city,
   town, or address on Earth can be located — this is a plain navigation, not a fetch() call,
   so it isn't affected by the network restrictions that limit our own geocoding providers. */
/* Sets the Google Maps link's href right as the user clicks it (onclick runs before the
   browser follows the link), so this is a genuine user-clicked <a> navigation — the same
   pattern already used successfully for booking/activity links — rather than a programmatic
   window.open() or a synthetic .click(), either of which can be silently blocked in sandboxed
   environments. Returning false cancels the navigation (e.g. when the field is empty). */
function prepareGoogleMapsLink(anchorEl, prefix){
  const addrEl = document.getElementById(prefix+'-address');
  const q = addrEl ? addrEl.value.trim() : '';
  const msgEl = document.getElementById(prefix+'-geo-msg');
  if(!q){ if(msgEl) msgEl.textContent = 'Digite o nome do lugar ou endereço primeiro.'; return false; }
  anchorEl.href = 'https://www.google.com/maps/search/?api=1&query='+encodeURIComponent(q);
  if(msgEl) msgEl.textContent = '🗺️ Abrindo o Google Maps numa nova aba...';
  return true;
}

/* Location section reused by the new-trip and destination modals: free-text address/city
   search (works anywhere, tries automatically first), a Google Maps shortcut for finding
   literally any place on the planet, and manual lat/lng as the fallback that always works. */
function geoSectionHtml(prefix, latVal, lngVal){
  return `
    <div class="note" style="margin:10px 0 6px;">📍 Digite qualquer cidade, ponto turístico ou endereço completo (por exemplo, o endereço de um hotel) — não há lista restrita, pode ser qualquer lugar do mundo.</div>
    <div class="row">
      <div class="field"><label>Cidade ou endereço</label><input id="${prefix}-address" placeholder="Ex: Orlando, FL — ou o endereço do hotel"></div>
    </div>
    <div class="row">
      <button type="button" class="btn ghost sm" onclick="geocodeInto('${prefix}-address','${prefix}-lat','${prefix}-lng','${prefix}-geo-msg')">🔎 Tentar buscar automaticamente</button>
      <a href="#" target="_blank" rel="noopener" class="btn ghost sm" style="text-decoration:none;display:inline-block;" onclick="return prepareGoogleMapsLink(this,'${prefix}')">🗺️ Abrir no Google Maps</a>
    </div>
    <div id="${prefix}-geo-msg" class="note"></div>
    <div class="note" style="margin-top:6px;">Se abrir o Google Maps: toque e segure (ou clique com o botão direito) no local certo, copie as coordenadas e cole nos campos abaixo.</div>
    <div class="row" style="margin-top:8px;">
      <div class="field"><label>Latitude</label><input id="${prefix}-lat" type="number" step="any" value="${latVal!=null?latVal:''}"></div>
      <div class="field"><label>Longitude</label><input id="${prefix}-lng" type="number" step="any" value="${lngVal!=null?lngVal:''}"></div>
    </div>
  `;
}

